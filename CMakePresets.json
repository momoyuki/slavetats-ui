{
    "version": 2,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "$env{COMMONLIBSSE_COMPILER} $env{COMMONLIBSSE_PLATFORM} $env{COMMONLIBSSE_TEXT}"
            }
        },
        {
            "name": "vcpkg",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-skse",
                "VCPKG_HOST_TRIPLET": "x64-windows-skse",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "win32-unicode",
            "hidden": true,
            "environment": {
                "COMMONLIBSSE_PLATFORM": "-DWIN32_LEAN_AND_MEAN -DNOMINMAX",
                "COMMONLIBSSE_TEXT": "-DUNICODE -D_UNICODE"
            }
        },
        {
            "name": "x64",
            "hidden": true,
            "architecture": { "value": "x64", "strategy": "external" }
        },
        {
            "name": "msvc",
            "hidden": true,
            "environment": {
                "COMMONLIBSSE_COMPILER": "/permissive- /Zc:preprocessor /Zc:threadSafeInit /EHsc $penv{CXXFLAGS}"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-msvc-x64"
                }
            }
        },
        {
            "name": "build-release",
            "displayName": "Release (MSVC)",
            "inherits": ["base", "vcpkg", "win32-unicode", "x64", "msvc"],
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": { "type": "STRING", "value": "RelWithDebInfo" }
            }
        },
        {
            "name": "build-debug",
            "displayName": "Debug (MSVC)",
            "inherits": ["base", "vcpkg", "win32-unicode", "x64", "msvc"],
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": { "type": "STRING", "value": "Debug" }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "build-release"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "build-debug"
        }
    ]
}
